{{ 'nt.css' | asset_url | stylesheet_tag }}
<section class='nt nt-hero' aria-labelledby='nt-guide-h'>
  <div class='nt-wrap'>
    <div class='nt-hero__top'>
      <div>
        <span class='nt-kicker'>日本釣魚地陪</span>
        <p class='nt-disp' aria-hidden='true'><span>Fish</span><span><em>Japan</em></span></p>
        <h1 class='nt-h1' id='nt-guide-h'>不懂日文也沒關係，我帶你去釣日本的魚。</h1>
        <p class='nt-lead'>想在日本釣魚，最常卡在語言、規則和找不到釣點。從行程規劃、遊漁券、船家預約到現場說明，我用中文全程陪同。</p>
        <div style='margin-top:32px'>{% render 'nt-contact' %}</div>
        <ul class='nt-stickers'>
          <li class='nt-sticker'>中文全程陪同</li>
          <li class='nt-sticker'>只找合法登記的船家</li>
          <li class='nt-sticker'>依行程內容報價</li>
        </ul>
      </div>
      <div class='nt-hero__badges'>
        {% render 'nt-patch', kind: 'fish', uid: 'gd1', text: 'FISH JAPAN ★ SHORE ★ BOAT ★ STREAM ★ ', label: '日本釣魚徽章', rot: -8, size: 168 %}
        {% render 'nt-patch', kind: 'boat', uid: 'gd2', text: 'NATSUMEYA ★ FISHING GUIDE ★ ', label: '船釣徽章', rot: 9, size: 128 %}
      </div>
    </div>
  </div>
  {% render 'nt-land' %}
</section>

<section class='nt nt-sec' aria-labelledby='nt-guide-types'>
  <div class='nt-wrap'>
    <span class='nt-kicker'>行程類型</span>
    <h2 class='nt-h2' id='nt-guide-types' style='margin-top:0'>想怎麼釣，都可以討論。</h2>
    <div class='nt-trips'>
      <div class='nt-trip'>
        {% render 'nt-patch', kind: 'fuji', uid: 'tr1', text: 'SHORE ★ HARBOR ★ ROCKS ★ ', label: '岸釣', rot: -5, size: 96 %}
        <span class='nt-trip__en'>Shore</span><h3>岸釣・堤防・港口</h3>
        <p>以東京灣、三浦半島、房總半島一帶為主，例如輕型路亞釣竹莢魚（Ajing）。</p>
      </div>
      <div class='nt-trip'>
        {% render 'nt-patch', kind: 'boat', uid: 'tr2', text: 'BOAT ★ OFFSHORE ★ CHARTER ★ ', label: '船釣', rot: 4, size: 96 %}
        <span class='nt-trip__en'>Boat</span><h3>搭遊漁船出海</h3>
        <p>代為預約合法登記的遊漁船，並說明船上的規矩與釣法。</p>
      </div>
      <div class='nt-trip'>
        {% render 'nt-patch', kind: 'reel', uid: 'tr3', text: 'TACKLE SHOP ★ TOKYO ★ OSAKA ★ ', label: '釣具店巡禮', rot: -3, size: 96 %}
        <span class='nt-trip__en'>Tackle shops</span><h3>日本釣具店巡禮</h3>
        <p>陪你逛日本釣具店，幫你翻譯、挑選、比較，找日本限定的釣具。可安排半天行程。</p>
      </div>
    </div>
  </div>
</section>

<section class='nt nt--ink nt-sec' aria-labelledby='nt-guide-inc'>
  <div class='nt-wrap nt-split'>
    <div>
      <span class='nt-kicker'>服務內容</span>
      <h2 class='nt-h2' id='nt-guide-inc' style='margin-top:0'>你只要帶著興奮來，其他交給我。</h2>
      <p class='nt-lead'>交通、船資、遊漁券、餐飲等實際費用依實際金額另計，報價時一併說明。其他地區的釣場也可以討論。</p>
    </div>
    <ul class='nt-checks' style='margin-top:0'>
      <li><svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'><path d='M5 12.5l4.5 4.5L19 7.5'/></svg>依季節、潮汐和魚種規劃地點與時間</li>
      <li><svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'><path d='M5 12.5l4.5 4.5L19 7.5'/></svg>代購遊漁券、辦理需要的入場手續</li>
      <li><svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'><path d='M5 12.5l4.5 4.5L19 7.5'/></svg>只預約合法登記的遊漁船</li>
      <li><svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'><path d='M5 12.5l4.5 4.5L19 7.5'/></svg>協助租借或購買適合當地的釣具與餌</li>
      <li><svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'><path d='M5 12.5l4.5 4.5L19 7.5'/></svg>當地規定、釣場禮儀和安全須知，全部用中文說明</li>
    </ul>
  </div>
</section>

<section class='nt nt-sec' aria-labelledby='nt-guide-flow'>
  <div class='nt-wrap'>
    <span class='nt-kicker'>預約方式</span>
    <h2 class='nt-h2' id='nt-guide-flow' style='margin-top:0'>三個步驟預約。</h2>
    <ol class='nt-steps3'>
      <li class='nt-step3'>
        {% render 'nt-patch', kind: 'chat', uid: 'gf1', text: 'STEP 01 ★ TELL ME ★ STEP 01 ★ ', label: '第一步', rot: -6, size: 96 %}
        <span class='nt-step3__no'>STEP 01</span><h3>傳訊息告訴我</h3><p>預計日期、人數、釣魚經驗和想釣的魚種。</p>
      </li>
      <li class='nt-step3'>
        {% render 'nt-patch', kind: 'quote', uid: 'gf2', text: 'STEP 02 ★ PLAN ★ QUOTE ★ ', label: '第二步', rot: 5, size: 96 %}
        <span class='nt-step3__no'>STEP 02</span><h3>收到行程與報價</h3><p>依季節和天氣提出行程建議，並附上費用說明。</p>
      </li>
      <li class='nt-step3'>
        {% render 'nt-patch', kind: 'boat', uid: 'gf3', text: 'STEP 03 ★ GO FISHING ★ ', label: '第三步', rot: -3, size: 96 %}
        <span class='nt-step3__no'>STEP 03</span><h3>確認後出發</h3><p>安排遊漁券、船家和釣具，當天見面出發。</p>
      </li>
    </ol>
  </div>
</section>

{% schema %}
{"name": "NT 釣魚地陪頁", "settings": [], "presets": [{"name": "NT 釣魚地陪頁"}]}
{% endschema %}
