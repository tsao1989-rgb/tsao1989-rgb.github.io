{{ 'nt.css' | asset_url | stylesheet_tag }}
<section class='nt nt--ink nt-sec nt-cta' aria-labelledby='nt-cta-h-{{ section.id }}'>
  <div class='nt-wrap'>
    {%- assign u1 = 'cta1-' | append: section.id -%}
    {%- assign u2 = 'cta2-' | append: section.id -%}
    <div class='nt-cta__patches' aria-hidden='true'>
      {% render 'nt-patch', kind: 'chat', uid: u1, text: 'ASK US ★ LINE ★ FACEBOOK ★ ASK US ★ ', label: '詢問', rot: -8, size: 96 %}
      {% render 'nt-patch', kind: 'fish', uid: u2, text: 'NATSUMEYA ★ FROM JAPAN ★ ', label: 'Natsumeya', rot: 6, size: 96 %}
    </div>
    <p class='nt-disp' aria-hidden='true'><span>Ask <em>us</em></span></p>
    <h2 class='nt-h2' id='nt-cta-h-{{ section.id }}'>{{ section.settings.heading | default: '想找的釣具，現在就傳給我。' }}</h2>
    <p class='nt-lead'>{{ section.settings.lead | default: '型號、照片、網址都可以。每一則訊息都由店主親自回覆。' }}</p>
    {% render 'nt-contact', align: 'center' %}
  </div>
</section>

{% schema %}
{"name": "NT 聯絡按鈕", "settings": [{"type": "text", "id": "heading", "label": "標題"}, {"type": "textarea", "id": "lead", "label": "說明文字"}], "presets": [{"name": "NT 聯絡按鈕"}]}
{% endschema %}
