{%- comment -%}
  LINE / Facebook contact buttons. Update the two URLs below once the real links are ready.
  Params: align ('center' or blank), compact (true for the mobile sticky bar)
{%- endcomment -%}
{%- liquid
  assign line_url = 'https://line.me/R/ti/p/@YOUR_LINE_ID'
  assign fb_url = 'https://m.me/YOUR_FACEBOOK_PAGE'
-%}
<div class='nt-btns{% if align == 'center' %} nt-btns--center{% endif %}'>
  <a class='nt-btn nt-btn--go' href='{{ line_url }}' target='_blank' rel='noopener'>
    <svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'><path d='M21 11.5a8.4 8.4 0 0 1-9 8.4 9.3 9.3 0 0 1-3.7-.8L3 21l1.7-4.4A8.2 8.2 0 0 1 3 11.5 8.6 8.6 0 0 1 12 3.1a8.6 8.6 0 0 1 9 8.4z'/></svg>
    {%- if compact %}LINE 詢問{% else %}用 LINE 詢問{% endif -%}
  </a>
  <a class='nt-btn nt-btn--ghost' href='{{ fb_url }}' target='_blank' rel='noopener'>
    {%- if compact %}Facebook{% else %}Facebook 詢問{% endif -%}
    <svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'><path d='M5 12h14M13 6l6 6-6 6'/></svg>
  </a>
</div>
