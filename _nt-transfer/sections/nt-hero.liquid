{{ 'nt.css' | asset_url | stylesheet_tag }}
<section class='nt nt-hero' aria-labelledby='nt-hero-h'>
  <div class='nt-wrap'>
    <div class='nt-hero__top'>
      <div>
        <span class='nt-kicker'>日本釣具代購 ＋ 日本釣魚地陪</span>
        <p class='nt-disp' aria-hidden='true'><span>Tackle</span><span><em>From Japan</em></span></p>
        <h1 class='nt-h1' id='nt-hero-h'>台灣買不到的日本釣具，我在日本幫你找、幫你寄。</h1>
        <ul class='nt-stickers'>
          <li class='nt-sticker'>先報價・再付款</li>
          <li class='nt-sticker'>人在日本現場找貨</li>
          <li class='nt-sticker'>EMS 全程追蹤</li>
        </ul>
      </div>
      <div class='nt-hero__badges'>
        {% render 'nt-patch', kind: 'fuji', uid: 'hero1', text: 'NATSUMEYA ★ JAPAN TACKLE ★ NATSUMEYA ★ JAPAN ★', label: '日本釣具徽章', rot: 8, size: 168 %}
        {% render 'nt-patch', kind: 'reel', uid: 'hero2', text: 'REELS ★ LURES ★ RODS ★ TACKLE ★ ', label: '捲線器徽章', rot: -10, size: 128 %}
      </div>
    </div>

    <div class='nt-paths'>
      <article class='nt-path'>
        <div class='nt-path__head'><span class='nt-path__no'>01 · Tackle</span></div>
        <h2>日本釣具代購</h2>
        <p>捲線器、路亞、釣竿、配件、日本限定款。傳型號或照片給我，我在日本找貨、報價，付款後以 EMS 寄到台灣。</p>
        {% render 'nt-contact' %}
      </article>
      <article class='nt-path nt-path--alt'>
        <div class='nt-path__head'><span class='nt-path__no'>02 · Fishing guide</span></div>
        <h2>日本釣魚地陪</h2>
        <p>來日本想釣魚？遊漁券、船家預約、釣點和當地規則，我用中文全程陪你。</p>
        <div class='nt-btns'>
          <a class='nt-btn nt-btn--ghost' href='/pages/fishing-guide'>了解地陪服務
            <svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'><path d='M5 12h14M13 6l6 6-6 6'/></svg>
          </a>
        </div>
      </article>
    </div>
  </div>
  {% render 'nt-land' %}
</section>

{% schema %}
{"name": "NT 首頁主視覺", "settings": [], "presets": [{"name": "NT 首頁主視覺"}]}
{% endschema %}
