# 地震ライブ配信の設定（/etc/quake-live/main.env）
# 変更したら: sudo quake-live restart

# YouTube Studio の「ストリームキー」（sudo quake-live setkey で設定できます）
YT_KEY=""

# 画面の言語: ja / en / zh（繁體中文）
PAGE_LANG="ja"

# 画面左上のタイトル（空なら言語ごとの標準名）
CHANNEL_NAME=""

# 画質: 1920x1080 / 4500k が標準。CPUが足りなければ 1280x720 / 2500k
RESOLUTION="1920x1080"
VIDEO_BITRATE="4500k"
FPS="30"
PRESET="veryfast"

# 緊急地震速報のときにP波・S波の円を表示する: 1 / 表示しない: 0
SHOW_WAVES="1"

# 緊急地震速報（予報）も表示する: 1 / 警報だけ表示: 0
EEW_FORECAST="1"

# 通知音を配信に乗せる: pulse / 無音: silent
AUDIO="pulse"

# 複数チャンネル（多言語など）を同時に動かすときは、設定ファイルごとに DISPLAY_NUM を変える（99, 100, 101…）
DISPLAY_NUM="99"
WEB_PORT="8080"
