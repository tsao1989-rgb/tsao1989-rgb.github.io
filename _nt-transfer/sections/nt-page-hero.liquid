{{ 'nt.css' | asset_url | stylesheet_tag }}
<section class='nt nt-phero'>
  <div class='nt-wrap'>
    {%- if section.settings.kicker != blank %}<span class='nt-kicker'>{{ section.settings.kicker }}</span>{% endif -%}
    {%- if section.settings.display != blank -%}
      <p class='nt-disp nt-disp--md' aria-hidden='true'>{{ section.settings.display }}</p>
    {%- endif -%}
    <h1 class='nt-h1'>{{ page.title | default: section.settings.title }}</h1>
    {%- if section.settings.lead != blank %}<p class='nt-lead'>{{ section.settings.lead }}</p>{% endif -%}
  </div>
</section>

{% schema %}
{"name": "NT 頁面標題", "settings": [{"type": "text", "id": "kicker", "label": "小標"}, {"type": "text", "id": "display", "label": "英文大字"}, {"type": "text", "id": "title", "label": "標題（頁面沒有標題時使用）"}, {"type": "textarea", "id": "lead", "label": "說明文字"}], "presets": [{"name": "NT 頁面標題"}]}
{% endschema %}
