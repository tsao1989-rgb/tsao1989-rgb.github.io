{{ 'nt.css' | asset_url | stylesheet_tag }}
<section class='nt nt-sec' aria-labelledby='nt-gt-h' style='background:var(--nt-cream2)'>
  <div class='nt-wrap nt-split'>
    <div class='nt-scene'>
      <svg class='nt-scene__art' viewBox='0 0 400 340' preserveAspectRatio='xMidYMid slice' aria-hidden='true' focusable='false'>
        <circle cx='300' cy='96' r='44' fill='#FFD84A'/>
        <polygon points='150,250 282,112 414,250' fill='#173A30'/>
        <polygon points='262,133 282,112 302,133 294,139 288,133 282,141 276,133 270,139' fill='#F2ECE1'/>
        <path d='M-10 236 Q60 196 140 226 T260 240 L260 260 L-10 260 Z' fill='#1F4A3D'/>
        <rect x='0' y='236' width='400' height='104' fill='#0C1830'/>
        <line x1='0' y1='256' x2='400' y2='256' stroke='#F2ECE1' stroke-width='3' stroke-dasharray='18 22'/>
        <line x1='10' y1='280' x2='400' y2='280' stroke='#F2ECE1' stroke-width='2.5' stroke-dasharray='12 30' opacity='.7'/>
        <path d='M200 244 L300 244 L286 262 L214 262 Z' fill='#F2ECE1'/>
        <rect x='222' y='226' width='24' height='18' fill='#FFD84A'/>
        <circle cx='278' cy='224' r='6' fill='#F2ECE1'/><rect x='272' y='230' width='12' height='14' fill='#F2ECE1'/>
        <path d='M282 232 Q320 178 372 166' fill='none' stroke='#F2ECE1' stroke-width='2.5' stroke-linecap='round'/>
        <line x1='372' y1='166' x2='380' y2='300' stroke='#F2ECE1' stroke-width='1.2'/>
        <circle cx='380' cy='300' r='5' fill='#FFD84A'/>
      </svg>
      <span class='nt-sticker' style='position:absolute;top:22px;left:22px'>中文全程陪同</span>
      {% render 'nt-patch', kind: 'fish', uid: 'gt1', text: 'FISH JAPAN ★ SHORE ★ BOAT ★ STREAM ★ ', label: '日本釣魚地陪徽章', rot: -8, size: 128 %}
      <style>.nt-scene .nt-patch{left:20px;bottom:20px}</style>
    </div>
    <div>
      <span class='nt-kicker'>日本釣魚地陪</span>
      <p class='nt-disp nt-disp--md' aria-hidden='true'><span>Fish</span><span><em>Japan</em></span></p>
      <h2 class='nt-h2' id='nt-gt-h'>來日本，我帶你去釣。</h2>
      <p class='nt-lead'>不懂日文、不知道規矩、找不到釣點？交給我安排，你只要帶著興奮來。</p>
      <ul class='nt-checks'>
        <li><svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'><path d='M5 12.5l4.5 4.5L19 7.5'/></svg>依季節、潮汐和魚種規劃釣點</li>
        <li><svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'><path d='M5 12.5l4.5 4.5L19 7.5'/></svg>代購遊漁券、預約合法登記的遊漁船</li>
        <li><svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'><path d='M5 12.5l4.5 4.5L19 7.5'/></svg>協助安排租借或購買釣具</li>
        <li><svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'><path d='M5 12.5l4.5 4.5L19 7.5'/></svg>當地規則、禮儀與安全，用中文說明</li>
      </ul>
      <div class='nt-btns'>
        <a class='nt-btn nt-btn--ghost' href='/pages/fishing-guide'>了解地陪服務
          <svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'><path d='M5 12h14M13 6l6 6-6 6'/></svg>
        </a>
      </div>
    </div>
  </div>
</section>

{% schema %}
{"name": "NT 地陪簡介", "settings": [], "presets": [{"name": "NT 地陪簡介"}]}
{% endschema %}
