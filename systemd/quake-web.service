[Unit]
Description=Quake Live - dashboard web server (local only)
After=network-online.target
Wants=network-online.target

[Service]
User=quake
ExecStart=/usr/bin/python3 -m http.server 8080 --bind 127.0.0.1 --directory /opt/quake-live/web
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
