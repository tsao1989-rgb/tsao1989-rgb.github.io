{%- comment -%}
  Embroidered-patch badge. Params: kind (fuji|fish|reel|box|chat|quote|boat), uid (unique id), text (ring text), label (accessible name), rot (degrees), size (px)
{%- endcomment -%}
{%- liquid
  assign navy = '#0C1830'
  assign cream = '#F2ECE1'
  assign go = '#06C755'
  assign sea = '#6CC4DC'
  assign sun = '#FFD84A'
  assign pine = '#173A30'
  case kind
    when 'fuji'
      assign inner = sea
    when 'fish'
      assign inner = navy
    when 'reel'
      assign inner = sun
    when 'box'
      assign inner = sea
    when 'chat'
      assign inner = go
    when 'quote'
      assign inner = sun
    else
      assign inner = sea
  endcase
-%}
<svg class='nt-patch' viewBox='0 0 160 160' role='img' aria-label='{{ label | escape }}' style='--r:{{ rot | default: 0 }}deg;{% if size %}--s:{{ size }}px;{% endif %}'>
  <defs>
    <clipPath id='np-c-{{ uid }}'><circle cx='80' cy='80' r='50'/></clipPath>
    <path id='np-t-{{ uid }}' d='M80,80 m-62,0 a62,62 0 1,1 124,0 a62,62 0 1,1 -124,0'/>
  </defs>
  <circle cx='80' cy='80' r='77' fill='{{ navy }}' stroke='{{ cream }}' stroke-width='3'/>
  <circle cx='80' cy='80' r='70.5' fill='none' stroke='{{ cream }}' stroke-width='1.2' stroke-dasharray='3 4' opacity='.55'/>
  <text font-size='12.5' fill='{{ cream }}'><textPath href='#np-t-{{ uid }}' textLength='384' lengthAdjust='spacing'>{{ text }}</textPath></text>
  <circle cx='80' cy='80' r='50' fill='{{ inner }}'/>
  <g clip-path='url(#np-c-{{ uid }})'>
    {%- case kind -%}
      {%- when 'fuji' -%}
        <circle cx='106' cy='60' r='12' fill='{{ sun }}'/>
        <polygon points='26,122 80,62 134,122' fill='{{ pine }}'/>
        <polygon points='67,77 80,62 93,77 87,82 80,76 73,82' fill='{{ cream }}'/>
        <rect x='26' y='106' width='108' height='30' fill='{{ navy }}'/>
        <line x1='30' y1='113' x2='130' y2='113' stroke='{{ cream }}' stroke-width='2.5' stroke-dasharray='9 7'/>
        <line x1='36' y1='121' x2='130' y2='121' stroke='{{ cream }}' stroke-width='2' stroke-dasharray='6 9' opacity='.7'/>
      {%- when 'fish' -%}
        <circle cx='44' cy='60' r='3' fill='{{ cream }}' opacity='.8'/><circle cx='38' cy='69' r='2' fill='{{ cream }}' opacity='.6'/>
        <path d='M42 82 C58 63 96 63 108 80 C96 97 58 100 42 82 Z' fill='{{ sea }}'/>
        <polygon points='105,80 125,64 122,96' fill='{{ sea }}'/>
        <path d='M66 72 Q61 82 66 92' fill='none' stroke='{{ navy }}' stroke-width='2'/>
        <path d='M68 85 Q88 79 106 80' fill='none' stroke='{{ sun }}' stroke-width='3' stroke-linecap='round'/>
        <circle cx='55' cy='78' r='4' fill='{{ cream }}'/><circle cx='55.5' cy='78' r='1.8' fill='{{ navy }}'/>
      {%- when 'reel' -%}
        <rect x='34' y='110' width='92' height='7' rx='3.5' fill='{{ pine }}'/>
        <rect x='86' y='94' width='9' height='18' fill='{{ navy }}'/>
        <rect x='52' y='60' width='26' height='42' rx='7' fill='{{ navy }}'/>
        <line x1='56' y1='70' x2='74' y2='70' stroke='{{ cream }}' stroke-width='2'/><line x1='56' y1='78' x2='74' y2='78' stroke='{{ cream }}' stroke-width='2'/><line x1='56' y1='86' x2='74' y2='86' stroke='{{ cream }}' stroke-width='2'/>
        <circle cx='92' cy='80' r='19' fill='{{ navy }}'/>
        <circle cx='92' cy='80' r='6' fill='{{ go }}'/>
        <line x1='92' y1='80' x2='113' y2='62' stroke='{{ navy }}' stroke-width='5' stroke-linecap='round'/>
        <circle cx='115' cy='60' r='6.5' fill='{{ cream }}' stroke='{{ navy }}' stroke-width='2.5'/>
      {%- when 'box' -%}
        <path d='M38 60 Q80 34 122 54' fill='none' stroke='{{ cream }}' stroke-width='2.5' stroke-dasharray='5 5'/>
        <polygon points='114,48 128,54 115,60 118,54' fill='{{ cream }}'/>
        <rect x='46' y='68' width='68' height='46' fill='{{ sun }}' stroke='{{ navy }}' stroke-width='3'/>
        <rect x='75' y='68' width='10' height='46' fill='{{ cream }}' stroke='{{ navy }}' stroke-width='2'/>
        <rect x='52' y='96' width='18' height='10' fill='{{ navy }}'/>
      {%- when 'chat' -%}
        <rect x='36' y='52' width='88' height='52' rx='16' fill='{{ cream }}'/>
        <polygon points='54,100 48,120 72,102' fill='{{ cream }}'/>
        <circle cx='62' cy='78' r='5.5' fill='{{ navy }}'/><circle cx='80' cy='78' r='5.5' fill='{{ navy }}'/><circle cx='98' cy='78' r='5.5' fill='{{ navy }}'/>
      {%- when 'quote' -%}
        <rect x='52' y='40' width='56' height='76' rx='4' fill='{{ cream }}' stroke='{{ navy }}' stroke-width='2.5'/>
        <line x1='60' y1='56' x2='100' y2='56' stroke='{{ navy }}' stroke-width='2.5' opacity='.55'/>
        <line x1='60' y1='66' x2='92' y2='66' stroke='{{ navy }}' stroke-width='2.5' opacity='.55'/>
        <line x1='60' y1='76' x2='96' y2='76' stroke='{{ navy }}' stroke-width='2.5' opacity='.55'/>
        <circle cx='80' cy='98' r='11' fill='{{ go }}'/>
        <path d='M74.5 98 l4 4.5 l7.5 -9' fill='none' stroke='{{ navy }}' stroke-width='3' stroke-linecap='round' stroke-linejoin='round'/>
      {%- else -%}
        <circle cx='58' cy='58' r='10' fill='{{ sun }}'/>
        <path d='M98 92 Q116 60 134 50' fill='none' stroke='{{ navy }}' stroke-width='3'/>
        <line x1='130' y1='52' x2='122' y2='112' stroke='{{ cream }}' stroke-width='1.5'/>
        <path d='M42 96 L114 96 L104 110 L52 110 Z' fill='{{ navy }}'/>
        <rect x='58' y='80' width='22' height='16' fill='{{ cream }}'/>
        <circle cx='96' cy='82' r='5' fill='{{ navy }}'/><rect x='91' y='86' width='10' height='10' fill='{{ navy }}'/>
        <rect x='26' y='108' width='108' height='30' fill='{{ pine }}'/>
        <line x1='30' y1='116' x2='130' y2='116' stroke='{{ cream }}' stroke-width='2.5' stroke-dasharray='9 7'/>
    {%- endcase -%}
  </g>
  <circle cx='80' cy='80' r='50' fill='none' stroke='{{ cream }}' stroke-width='2.5'/>
</svg>
